    {
      "name": "Sales Challans",
      "item": [
        {
          "name": "List challans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/challans?page=1&pageSize=10&status=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": ""
                }
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Create challan (Draft)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans"
              ]
            },
            "description": "Creates a challan in DRAFT status. Draft challans do NOT affect stock until confirmed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"status\": \"DRAFT\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 3\n    }\n  ]\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('Challan created', () => pm.response.to.have.status(201));",
                  "if (data.challan) { pm.collectionVariables.set('challanId', data.challan.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Create challan (Confirmed directly)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans"
              ]
            },
            "description": "Creates and immediately confirms a challan. This reduces stock atomically inside a database transaction; if stock is insufficient, the whole request fails with HTTP 400 and no partial changes are made.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"status\": \"CONFIRMED\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            }
          },
          "response": []
        },
        {
          "name": "Get challan by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/challans/{{challanId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans",
                "{{challanId}}"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Confirm draft challan",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/challans/{{challanId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans",
                "{{challanId}}",
                "confirm"
              ]
            },
            "description": "Confirms a DRAFT challan, reducing stock for every line item. Fails with HTTP 400 (listing every short product) if any product doesn't have enough stock."
          },
          "response": []
        },
        {
          "name": "Cancel challan",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/challans/{{challanId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans",
                "{{challanId}}",
                "cancel"
              ]
            },
            "description": "Cancels a challan. If it was CONFIRMED, the stock that was deducted is automatically restored."
          },
          "response": []
        }
