{
  "info": {
    "name": "Mini ERP + CRM Operations Portal API",
    "description": "Full REST API collection for the Mini ERP + CRM Operations Portal case study. Set the `baseUrl` and `password` collection variables, run 'Login' first to auto-populate the `token` variable, then run any other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "productId2",
      "value": ""
    },
    {
      "key": "challanId",
      "value": ""
    },
    {
      "key": "password",
      "value": "Password@123"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Sales)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in and returns a JWT. The test script below saves the token into the `token` collection variable so every other request in this collection is authenticated automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@erpcrm.test\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('Login succeeded', () => pm.response.to.have.status(200));",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
